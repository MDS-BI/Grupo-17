erDiagram
    Entity ||--o{ CuentaContable : "cuenta auxiliar (opcional)"
    Entity ||--o{ AsientoContable : "tercero relacionado (opcional)"
    Entity ||--o{ LineaAsiento : "auxiliar por línea (opcional)"
    Entity ||--|{ Pago : "tercero (obligatorio)"
    Document |o--o{ AsientoContable : "origina (sourceDocumentId)"
    Document |o--o{ Pago : "se liquida (document_id)"
    PeriodoContable ||--|{ AsientoContable : "pertenece"
    CuentaContable |o--o{ CuentaContable : "jerarquía padre/hijo"
    CuentaContable ||--|{ LineaAsiento : "afecta (cuenta hoja y activa)"
    AsientoContable ||--|{ LineaAsiento : "contiene (>= 2, cascada)"
    Pago |o--o| AsientoContable : "genera / corresponde (opcional)"

    Entity {
        string entity_id PK
        string name
        string code
        string taxId
        string category
    }
    Document {
        string id PK
        string entity_id FK
        string series
        number folio
        number totalAmount
        string currency
        string status
    }
    ModuleConfig {
        string moduleName PK
        object labels
        object customFields
        object statusLifecycle
    }
    CuentaContable {
        string id PK
        string code UK
        string name
        string type
        string parent_id FK
        boolean isLeaf
        string entity_id FK
        string normalBalance
        string status
    }
    PeriodoContable {
        string id PK
        string name UK
        string startDate
        string endDate
        string status
    }
    AsientoContable {
        string id PK
        string series
        number folio
        string date
        string period_id FK
        string concept
        string sourceDocumentType
        string sourceDocumentId FK
        string entity_id FK
        number totalDebit
        number totalCredit
        string currency
        string status
    }
    LineaAsiento {
        string id PK
        string asiento_id FK
        string cuenta_id FK
        string concept
        number debit
        number credit
        string entity_id FK
    }
    Pago {
        string id PK
        string numero UK
        string series
        number folio
        string date
        string entity_id FK
        string document_id FK
        string asiento_id FK
        number amount
        string currency
        string method
        string status
    }
